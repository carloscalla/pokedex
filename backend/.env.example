PORT=8080
ALLOWED_ORIGIN=http://localhost:5173

# Supabase Postgres connection string. Use the "Session" or "Direct connection"
# string from Supabase's Project Settings -> Database page (NOT the "Transaction
# pooler"/PgBouncer one on :6543 - this is a long-running server, not serverless,
# and the transaction-mode pooler can break pgx's use of prepared statements).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Required. Any long random string - used to sign/verify JWTs.
JWT_SECRET=change-me-to-a-long-random-string

# Required only if you plan to call POST /api/admin/sync.
ADMIN_TOKEN=change-me-to-a-long-random-string

POKEAPI_BASE_URL=https://pokeapi.co/api/v2
